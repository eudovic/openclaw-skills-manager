# Copy this file to `.env` and fill it only in your local environment.
# Never commit `.env` or replace placeholders in this file with real credentials.
OPENCLAW_APP_TITLE=OpenClaw Skill Studio
OPENCLAW_APP_LOGIN_USER=
OPENCLAW_APP_LOGIN_PASS=
OPENCLAW_APP_SESSION_SECRET=change-me
OPENCLAW_APP_SESSION_SECURE=0
# Host path mounted by docker-compose as the workspace root inside the container.
# Point this to the same workspace path used by the gateway.
OPENCLAW_WORKSPACE_HOST_PATH=.
OPENCLAW_WORKSPACE_ROOT=/workspace
OPENCLAW_SKILLS_DIR=/workspace/skills
OPENCLAW_STUDIO_DATA_ROOT=/studio-data
# Optional external Docker volume that exposes the same /data used by OpenClaw.
OPENCLAW_REMOTE_DATA_VOLUME_NAME=
OPENCLAW_REMOTE_DATA_MOUNT=/remote-data
# Optional path inside the container for a real mirror of remote workspace skills.
# Example in a custom deployment: /remote-skills/public
OPENCLAW_REMOTE_SKILLS_MIRROR_ROOT=
# Optional server-side hooks for exact remote import/sync when the gateway itself does not expose file RPCs.
OPENCLAW_REMOTE_SKILLS_PULL_COMMAND=
OPENCLAW_REMOTE_SKILLS_PUSH_COMMAND=
OPENCLAW_REMOTE_SSH_HOST=
OPENCLAW_REMOTE_SSH_PORT=22
OPENCLAW_REMOTE_SSH_USER=
OPENCLAW_REMOTE_SSH_PASSWORD=
OPENCLAW_REMOTE_DOCKER_CONTAINER=

# Gateway defaults used by the backend after app authentication.
OPENCLAW_GATEWAY_URL=ws://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_BASIC_USER=
OPENCLAW_GATEWAY_BASIC_PASS=

# Optional automation hooks triggered from the UI
# OPENCLAW_SKILLS_APPLY_COMMAND=openclaw gateway restart
# OPENCLAW_GATEWAY_RESTART_COMMAND=openclaw gateway restart
# OPENCLAW_SKILLS_VALIDATE_COMMAND=openclaw skills check --json
# OPENCLAW_SKILLS_TEST_COMMAND=openclaw agent --message "use my custom skill"

PORT=8765
FLASK_DEBUG=0
